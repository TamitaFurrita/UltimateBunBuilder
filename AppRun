# === Downloading Kron4ek's Wine build (Latest Staging) ===
if [ ! -d "$WINEDIR" ]; then
    progress "Fetching latest Wine-Staging version..."

    if [ -z "$LATEST_VERSION" ]; then
        confirm "Could not fetch latest Wine version.

        This usually happens because curl isn't working, or missing."
        exit 1
    fi

    DOWNLOAD_URL="https://github.com/Kron4ek/Wine-Builds/releases/download/11.10/wine-11.10-staging-amd64-wow64.tar.xz"

    close_progress

    progress "Downloading Wine ${LATEST_VERSION} (Staging + WoW64)..."

    wget -P "$VARDIR" "$DOWNLOAD_URL"

    tar -xf "$VARDIR/$TARBALL" -C "$VARDIR"
    rm "$VARDIR/"*.tar.xz* 2>/dev/null

    close_progress
fi

# === Wine prefix initialization ===
if [ ! -d "$WINEPREFIX" ]; then
    echo "Initializing Wine prefix for the first time..."

    progress "Initializing Wine prefix..."

    tar -xf "${HERE}/ultimatebunbuilder.tar.xz" -C "${HOME}"

    bash -c "/usr/bin/wineboot -i; /usr/bin/wineserver -k"

    close_progress

    touch "${WINEPREFIX}/.first_run_done"
fi

export WINE="${WINEDIR}/bin/wine"

# === Run requested commands ===
if [ "$1" = "winetricks" ]; then
    notify "Running bundled Winetricks..."
    exec "${HERE}/bin/winetricks" "${@:2}"

elif [ $# -eq 0 ]; then
    notify "Launching Ultimate Doom Builder..."
    exec "$WINE" "$UDB"

else
    notify "Running $1..."
    exec "$WINE" "$@"
fi
