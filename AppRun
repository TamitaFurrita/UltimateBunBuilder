#!/usr/bin/env bash

export __﻿GL_MaxFramesAllowed="1" # Fuck NVIDIA

export HERE="$(dirname "$(readlink -f "${0}")")"
export WINEDEBUG=-all

source "$HERE/DialogWrap"

export LATEST_VERSION="11.10"

export VARDIR="${HOME}/.var/"
export WINEDIR="$VARDIR/wine-${LATEST_VERSION}-staging-amd64-wow64"
export WINEPREFIX="${HOME}/.ultimatebunbuilder/"

export UDB="${WINEPREFIX}/drive_c/users/Public/UltimateDoomBuilder/Builder.exe"

# === Initializing these for later ===
DBUS_REF=""
ZENITY_PID=""
QDBUS="qdbus"

# === Dialog backend detection ===
DIALOG_BACKEND="none"

if command -v kdialog >/dev/null 2>&1; then
    DIALOG_BACKEND="kdialog"
    echo "Found kdialog"
elif command -v zenity >/dev/null 2>&1; then
    DIALOG_BACKEND="zenity"
    echo "Found zenity"
fi

# === Check qdbus binary name ===
if command -v qdbus-qt6 >/dev/null 2>&1; then
    QDBUS=qdbus-qt6
    echo "$QDBUS"
elif command -v qdbus >/dev/null 2>&1; then
    QDBUS=qdbus
    echo "$QDBUS"
elif command -v qdbus6 >/dev/null 2>&1; then
    QDBUS=qdbus6
    echo "$QDBUS"
else
    error "qDBus not found. This is normal for GNOME-based DEs." >&2
fi

# === First-time user dialog ===
if [ ! -f "${WINEPREFIX}/.first_run_done" ]; then
    if ! confirm \
"Welcome to the online build of Tamara Mochaccina's Ultimate Bun Builder!

This AppImage will create a Wine prefix with .NET 4.7.2 for you, and
subsequently launch Ultimate Doom Builder R4317 on Wine-Staging ${LATEST_VERSION}.

WARNING: This process will eat up 2.4 gigabytes of storage on your device.
Blame Microslop.

Confirm to continue."; then
        echo "User canceled first-time setup."
        exit 0
    fi
fi

